# Copy to application-local.properties (untracked) and run with SPRING_PROFILES_ACTIVE=local.
# Secrets only through the environment variables referenced below; never write them in this file.

server.port=8082
management.endpoints.web.exposure.include=*

# Event bus (Azure Event Hubs over the Kafka protocol)
spring.cloud.stream.kafka.binder.brokers=${EVENTHUB_HOST}:${EVENTHUB_PORT:9093}
spring.cloud.stream.kafka.binder.configuration.sasl.jaas.config=org.apache.kafka.common.security.plain.PlainLoginModule required username="$ConnectionString" password="Endpoint=sb://${EVENTHUB_HOST}/;SharedAccessKeyName=${EVENTHUB_KEY_NAME};SharedAccessKey=${EVENTHUB_SHARED_ACCESS_KEY}";
spring.cloud.stream.bindings.receive-in-0.destination=tx_eng.interbank
spring.cloud.stream.bindings.receive-in-0.group=approval-order-engine-consumer
spring.cloud.stream.bindings.retry-out-0.destination=tx_eng.interbank

# Redis
spring.data.redis.host=${REDIS_HOST}
spring.data.redis.port=6380
spring.data.redis.password=${REDIS_PASSWORD}

# Retry policy, in seconds
interbank.retry.initial-seconds=0
interbank.retry.step-seconds=30
interbank.retry.limit-seconds=120

# Process codes and error status
interbank.process.execute-code=INTERBANK04
interbank.process.modify-code=INTERBANK02
interbank.process.error-status=ERROR

interbank.notification.channel=INTERBANK

# Downstream APIs (local stubs)
interbank.downstream.urls.sp-interbank-transfer-order=http://localhost:8081/support/banking/v1/
interbank.downstream.urls.bs-interbank-transfer-order=http://localhost:8083/business/banking/v1/
interbank.downstream.urls.bs-order=http://localhost:8084/business/banking/v1/
interbank.downstream.system-user-id=local-system-user
interbank.downstream.app-name=Banking
interbank.downstream.device=localhost
interbank.downstream.device-ip=127.0.0.1
interbank.downstream.agency=local-agency
interbank.downstream.geolocation=0,0
